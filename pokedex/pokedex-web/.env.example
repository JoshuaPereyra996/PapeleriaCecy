# ============================================================================
# Copia como .env  ·  NUNCA lo subas a GitHub (ya está en .gitignore)
# En Hostinger estos valores se cargan desde hPanel → Environment Variables,
# no como archivo.
# ============================================================================

NODE_ENV=production
PORT=3000

# Ruta donde vive la Pokédex dentro de tu dominio.
# Debe coincidir con el app.use("/pokedex", ...) de tu app principal.
BASE_PATH=/pokedex

# --- Sesiones ---------------------------------------------------------------
# OBLIGATORIO. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si cambias este valor, todas las sesiones abiertas se invalidan.
#CAMBIOS PARA HACER COMMIT

SESSION_SECRET=
SESSION_TTL_MS=2592000000

# --- Base de datos MySQL de Hostinger --------------------------------------
# Los datos salen de hPanel → Bases de datos → Administración de bases MySQL.
# Desde la propia app el host es localhost; para conectarte desde tu PC hay
# que habilitar MySQL remoto y añadir tu IP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_pokedex
DB_USER=u123456789_josh
DB_PASSWORD=
DB_POOL=5

# --- Proveedor de cartas: pokemontcg | scrydex ------------------------------
PROVIDER=pokemontcg
POKEMONTCG_API_KEY=
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

RETRIES=5
BACKOFF_MS=700
