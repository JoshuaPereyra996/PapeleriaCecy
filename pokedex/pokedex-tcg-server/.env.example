# ============================================================================
# Copia este archivo como  .env  y ajusta los valores.
#   cp .env.example .env
# NUNCA subas el .env a git: contiene tu API key.
# ============================================================================

PORT=3001

# Proveedor de datos de cartas: pokemontcg | scrydex
#
#   pokemontcg  Gratis, sin credenciales. Es el servicio original, sigue en pie
#               pero devuelve 502 de Cloudflare por rachas. El gateway los
#               reintenta y cachea, así que en la práctica casi no se notan.
#
#   scrydex     Sucesor oficial de pokemontcg.io. Datos mejores y estables,
#               pero NO tiene capa gratuita: requiere plan de pago
#               (desde 29 USD/mes por 5.000 créditos), API key y Team ID.
#
PROVIDER=pokemontcg

# --- pokemontcg.io ----------------------------------------------------------
# Opcional. Sin key: ~1.000 peticiones/día. Con key: 20.000/día.
# Se pide gratis en https://dev.pokemontcg.io
POKEMONTCG_API_KEY=df885fa6-b720-440d-87ed-b3ef0c332ce9


# --- Scrydex ----------------------------------------------------------------
# Se generan en el Account Hub tras suscribirte: https://scrydex.com/register
# Ambos son obligatorios si PROVIDER=scrydex.
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# --- Red --------------------------------------------------------------------
# Reintentos por petición y backoff inicial en ms (se duplica en cada intento).
RETRIES=5
BACKOFF_MS=700
