<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> · Papelería CeCy</title>
  <link rel="stylesheet" href="<%= base %>/css/styles.css">
</head>
<% const MODULOS = { libros:'Libros', maestros:'Maestros', ventas:'Ventas', reportes:'Reportes' }; %>
<body class="mod-<%= modulo %>">
  <header class="barra">
  <h1>Papelería Cecy<% if (MODULOS[modulo]) { %> · <%= MODULOS[modulo] %><% } %></h1>
  <% if (usuario) { %>
    <div class="usuario-barra">
      <span><%= usuario.nombre %></span>
      <form action="<%= base %>/logout" method="POST" style="display:inline;">
        <button type="submit" class="btn-salir">Salir</button>
      </form>
    </div>
  <% } %>
</header>
<% if (usuario) { %>
  <nav class="menu">
    <a href="<%= base %>/" class="<%= modulo==='inicio'?'active':'' %>">Inicio</a>
    <a href="<%= base %>/libros" class="<%= modulo==='libros'?'active':'' %>">Libros</a>
    <a href="<%= base %>/maestros" class="<%= modulo==='maestros'?'active':'' %>">Maestros</a>
    <a href="<%= base %>/ventas" class="<%= modulo==='ventas'?'active':'' %>">Ventas</a>
    <a href="<%= base %>/reportes" class="<%= modulo==='reportes'?'active':'' %>">Reportes</a>
  </nav>
<% } %>
  <main class="contenido">
    <%- body %>
  </main>
</body>
</html>
