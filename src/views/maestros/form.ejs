<h2><%= maestro ? 'Editar maestro' : 'Nuevo maestro' %></h2>

<% if (error) { %><div class="error"><%= error %></div><% } %>

<form action="<%= maestro && maestro.id ? base + '/maestros/' + maestro.id : base + '/maestros' %>" method="POST" class="formulario">
  <label>Nombre completo</label>
  <input type="text" name="nombre_completo" value="<%= maestro ? maestro.nombre_completo : '' %>" required autofocus>

  <div class="form-botones">
    <button type="submit" class="btn btn-inline">Guardar</button>
    <a href="<%= base %>/maestros" class="btn-cancelar">Cancelar</a>
  </div>
</form>
