<div class="encabezado-seccion">
  <h2>Maestros</h2>
  <a href="<%= base %>/maestros/nuevo" class="btn btn-inline">+ Nuevo maestro</a>
</div>
<% if (maestros.length === 0) { %>
  <p>Aún no hay maestros registrados.</p>
<% } else { %>
  <table class="tabla">
    <thead><tr><th>Nombre completo</th><th>Libros asignados</th><th>Acciones</th></tr></thead>
    <tbody>
      <% maestros.forEach(m => { %>
        <tr>
          <td><%= m.nombre_completo %></td>
          <td><%= m.libros || '—' %></td>
          <td class="acciones">
            <a href="<%= base %>/maestros/<%= m.id %>/editar">Editar</a>
            <form action="<%= base %>/maestros/<%= m.id %>/eliminar" method="POST" onsubmit="return confirm('¿Dar de baja este maestro?');">
              <button type="submit" class="link-rojo">Baja</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
