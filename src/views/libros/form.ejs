<h2><%= libro ? 'Editar libro' : 'Nuevo libro' %></h2>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<form action="<%= libro && libro.id ? '/libros/' + libro.id : '/libros' %>" method="POST" class="formulario">
  <label>Título</label>
  <input type="text" name="titulo" value="<%= libro ? libro.titulo : '' %>" required>

  <label>Autor / Editorial</label>
  <input type="text" name="autor" value="<%= libro ? (libro.autor || '') : '' %>">

  <label>Precio al alumno</label>
  <input type="number" step="0.01" name="precio" value="<%= libro ? libro.precio : '' %>" required>

  <label>Margen para la papelería (por unidad)</label>
  <input type="number" step="0.01" name="margen_papeleria" value="<%= libro ? libro.margen_papeleria : '0' %>">

  <label>Comisión para el maestro (monto fijo por este libro)</label>
  <input type="number" step="0.01" name="comision_maestro" value="<%= libro ? libro.comision_maestro : '0' %>">

  <label>Cantidad entregada por la editorial</label>
  <input type="number" name="cantidad_entregada" value="<%= libro ? libro.cantidad_entregada : '0' %>">

  <label>Maestros que imparten este libro</label>
  <% if (maestros.length === 0) { %>
    <p class="nota">No hay maestros registrados. Da de alta maestros primero.</p>
  <% } else { %>
    <div class="checkbox-lista">
      <% maestros.forEach(m => { %>
        <label class="checkbox-item">
          <input type="checkbox" name="maestros" value="<%= m.id %>" <%= asignados.includes(String(m.id)) ? 'checked' : '' %>>
          <%= m.nombre_completo %>
        </label>
      <% }) %>
    </div>
  <% } %>

  <div class="form-botones">
    <button type="submit" class="btn btn-inline">Guardar</button>
    <a href="/libros" class="btn-cancelar">Cancelar</a>
  </div>
</form>