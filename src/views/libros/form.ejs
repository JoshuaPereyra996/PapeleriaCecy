<h2><%= libro ? 'Editar libro' : 'Nuevo libro' %></h2>
<% if (error) { %><div class="error"><%= error %></div><% } %>
<form action="<%= libro && libro.id ? base + '/libros/' + libro.id : base + '/libros' %>" method="POST" class="formulario">
  <label>Título</label>
  <input type="text" name="titulo" value="<%= libro ? libro.titulo : '' %>" required>

  <label>Autor / Editorial</label>
  <input type="text" name="autor" value="<%= libro ? (libro.autor || '') : '' %>">

  <label>Precio al alumno</label>
  <input type="number" step="0.01" name="precio" value="<%= libro ? libro.precio : '' %>" required>

  <label>Cantidad entregada por la editorial</label>
  <input type="number" name="cantidad_entregada" value="<%= libro ? libro.cantidad_entregada : '0' %>">

  <label>Margen papelería (por unidad vendida)</label>
  <input type="number" step="0.01" name="margen_papeleria" value="<%= libro ? libro.margen_papeleria : '0' %>">
  <p class="nota">Este monto no se muestra en el panel de Libros; solo se usa para calcular el margen de papelería en Reportes.</p>

  <label>Semestre al que pertenece</label>
  <select name="grado">
    <% // El valor guardado es 1/2/3 (año), etiquetado como semestre. Vacío = sin clasificar (aparece en todos los semestres). %>
    <option value="">— Sin clasificar —</option>
    <% [['1','1er SEMESTRE'], ['2','3ER SEMESTRE'], ['3','5TO SEMESTRE']].forEach(([val, txt]) => { %>
      <option value="<%= val %>" <%= libro && String(libro.grado) === val ? 'selected' : '' %>><%= txt %></option>
    <% }) %>
  </select>

  <label>Turno</label>
  <select name="turno">
    <% // Vacío = sin clasificar (aparece en cualquier turno), igual que el semestre. %>
    <option value="">— Sin clasificar —</option>
    <% ['Matutino','Vespertino'].forEach(op => { %>
      <option value="<%= op %>" <%= libro && libro.turno === op ? 'selected' : '' %>><%= op %></option>
    <% }) %>
  </select>

  <label>Maestros que imparten este libro</label>
  <% if (maestros.length === 0) { %>
    <p class="nota">No hay maestros registrados. Da de alta maestros primero.</p>
  <% } else { %>
    <div class="maestros-selector" id="maestros-selector">
      <div class="maestros-chips" id="maestros-chips"></div>
      <%# <details> nativo: la lista vive en el flujo normal, así que al abrirse
          empuja los botones hacia abajo en vez de flotar encima de ellos. %>
      <details class="maestros-desplegable" id="maestros-desplegable">
        <summary class="maestros-resumen">
          <span class="maestros-resumen-texto">Ver maestros</span>
          <span class="maestros-conteo" id="maestros-conteo"></span>
        </summary>
        <div class="maestros-lista">
          <% maestros.forEach(m => { %>
            <label class="checkbox-item maestros-opcion">
              <input type="checkbox" name="maestros" value="<%= m.id %>" <%= asignados.includes(String(m.id)) ? 'checked' : '' %>>
              <%= m.nombre_completo %>
            </label>
          <% }) %>
        </div>
      </details>
    </div>
  <% } %>

  <div class="form-botones">
    <button type="submit" class="btn btn-inline">Guardar</button>
    <a href="<%= base %>/libros" class="btn-cancelar">Cancelar</a>
  </div>
</form>

<% if (maestros.length > 0) { %>
<script>
  (function () {
    const desplegable = document.getElementById('maestros-desplegable');
    const chips = document.getElementById('maestros-chips');
    const conteo = document.getElementById('maestros-conteo');
    const opciones = [...desplegable.querySelectorAll('.maestros-opcion')];

    function pintar() {
      chips.innerHTML = '';
      let seleccionados = 0;
      opciones.forEach(op => {
        const input = op.querySelector('input');
        if (!input.checked) return;
        seleccionados++;
        const chip = document.createElement('span');
        chip.className = 'maestro-chip';
        chip.textContent = op.textContent.trim();
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'maestro-chip-quitar';
        quitar.textContent = '✕';
        quitar.addEventListener('click', () => { input.checked = false; pintar(); });
        chip.appendChild(quitar);
        chips.appendChild(chip);
      });
      conteo.textContent = seleccionados === 0
        ? 'ninguno seleccionado'
        : seleccionados + (seleccionados === 1 ? ' seleccionado' : ' seleccionados');
    }

    opciones.forEach(op => op.querySelector('input').addEventListener('change', pintar));
    pintar();
  })();
</script>
<% } %>
