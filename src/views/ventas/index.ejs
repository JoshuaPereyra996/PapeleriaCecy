<div class="encabezado-seccion">
  <h2>Ventas registradas</h2>
  <a href="<%= base %>/ventas/nueva" class="btn btn-inline">+ Registrar venta</a>
</div>
<form method="GET" action="<%= base %>/ventas" class="barra-busqueda">
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Buscar por nombre del alumno…" autofocus>
  <input type="text" name="folio" value="<%= folio || '' %>" placeholder="Folio…" inputmode="numeric" style="max-width:120px;">
  <button type="submit" class="btn btn-inline">Buscar</button>
  <% if (q || folio) { %><a href="<%= base %>/ventas" class="btn-cancelar">Limpiar</a><% } %>
</form>
<% if (folio) { %><p class="nota-info">Mostrando la venta con folio "<%= folio %>".</p>
<% } else if (q) { %><p class="nota-info">Mostrando resultados para "<%= q %>".</p><% } %>
<% if (ventas.length === 0) { %>
  <p>Aún no hay ventas registradas.</p>
<% } else { %>
  <table class="tabla">
    <thead>
      <tr><th>Folio</th><th>Fecha</th><th>Alumno</th><th>Grado/Grupo</th><th>Turno</th><th>Especialidad</th><th>Libros</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
      <% ventas.forEach(v => { %>
        <tr>
          <td><%= String(v.id).padStart(5, '0') %></td>
          <td><%= fmt.soloFecha(v.fecha) %></td>
          <td><%= v.alumno_nombre %></td>
          <td><%= v.grado %>° <%= v.grupo %></td>
          <td><%= v.turno %></td>
          <td><%= v.especialidad %></td>
          <td><%= v.num_libros %></td>
          <td>$<%= v.total %></td>
          <td class="acciones"><a href="<%= base %>/ventas/<%= v.id %>">Detalles</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <%
    // Construye la secuencia de páginas: siempre 1,2,3 y la última, más la
    // página actual y sus vecinas; los huecos se marcan con "…".
    function secuenciaPaginas(cur, total) {
      const set = new Set([1, 2, 3, cur - 1, cur, cur + 1, total]);
      const arr = [...set].filter(n => n >= 1 && n <= total).sort((a, b) => a - b);
      const out = []; let prev = 0;
      arr.forEach(n => { if (n - prev > 1) out.push('…'); out.push(n); prev = n; });
      return out;
    }
    const qParam = (q ? ('&q=' + encodeURIComponent(q)) : '') + (folio ? ('&folio=' + encodeURIComponent(folio)) : '');
    const urlPagina = p => `${base}/ventas?page=${p}${qParam}`;
  %>
  <% if (totalPaginas > 1) { %>
    <nav class="paginacion">
      <% if (pagina > 1) { %><a href="<%= urlPagina(pagina - 1) %>">‹ Anterior</a><% } %>
      <% secuenciaPaginas(pagina, totalPaginas).forEach(p => { %>
        <% if (p === '…') { %><span class="ellipsis">…</span>
        <% } else if (p === pagina) { %><span class="pag-actual"><%= p %></span>
        <% } else { %><a href="<%= urlPagina(p) %>"><%= p %></a><% } %>
      <% }) %>
      <% if (pagina < totalPaginas) { %><a href="<%= urlPagina(pagina + 1) %>">Siguiente ›</a><% } %>
    </nav>
    <p class="nota-info" style="text-align:center">Página <%= pagina %> de <%= totalPaginas %> · <%= total %> venta<%= total === 1 ? '' : 's' %> en total</p>
  <% } %>
<% } %>
